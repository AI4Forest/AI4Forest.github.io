  doi = {10.5194/essd-15-4927-2023},
  language = {English},
  number = {11},
  urldate = {2023-11-20},
  journal = {Earth System Science Data},
  author = {Schwartz, Martin and Ciais, Philippe and De Truchis, Aur{\'e}lien and Chave, J{\'e}r{\^o}me and Ottl{\'e}, Catherine and Vega, Cedric and Wigneron, Jean-Pierre and Nicolas, Manuel and Jouaber, Sami and Liu, Siyu and Brandt, Martin and Fayad, Ibrahim},
