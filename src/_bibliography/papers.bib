@article{schwartz_high-resolution_2024,
  title = {High-resolution canopy height map in the {Landes} forest ({France}) based on {GEDI}, {Sentinel}-1, and {Sentinel}-2 data with a deep learning approach},
  volume = {128},
  issn = {1569-8432},
  url = {https://www.sciencedirect.com/science/article/pii/S1569843224000657},
  doi = {10.1016/j.jag.2024.103711},
  urldate = {2024-04-16},
  journal = {International Journal of Applied Earth Observation and Geoinformation},
  author = {Schwartz, Martin and Ciais, Philippe and Ottl{\'e}, Catherine and De Truchis, Aurelien and Vega, Cedric and Fayad, Ibrahim and Brandt, Martin and Fensholt, Rasmus and Baghdadi, Nicolas and Morneau, Fran{\c c}ois and Morin, David and Guyon, Dominique and Dayau, Sylvia and Wigneron, Jean-Pierre},
  author_id = {martin_schwartz},
  month = apr,
  year = {2024},
  keywords = {Forest height, GEDI, Landes forest, Sentinel-1, Sentinel-2, 3D Stereo, Deep Learning, Forest Inventory, U-Net},
  pages = {103711},
  bibtex_show = {false},
  tags = {chm,resolution},
  preview = {schwartz2024highrezLand.png},
  abstract = {https://www-sciencedirect-com.insu.bib.cnrs.fr/science/article/pii/S1569843224000657#:~:text=Open%20access-,Abstract,-In%20intensively%20managed},
  abstract_preview = {In intensively managed forests in Europe, where forests are divided into stands of small size and may show heterogeneity within stands, a high spatial resolution (10–––20 m) is needed to capture the differences in canopy height. In this work, we developed a deep learning model based on multi-sensor remote sensing measurements to create a high-resolution canopy height map over the “Landes de Gascogne” forest in France, a large maritime pine plantation of 13,000 km2 with flat terrain and intensive management.}
}

