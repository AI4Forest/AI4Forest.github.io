@article{schwartz_forms_2023,
  title = {{FORMS}: {Forest} {Multiple} {Source} height, wood volume, and biomass maps in {France} at 10 to 30\&thinsp;m resolution based on {Sentinel}-1, {Sentinel}-2, and {Global} {Ecosystem} {Dynamics} {Investigation} ({GEDI}) data with a deep learning approach},
